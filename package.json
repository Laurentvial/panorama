{
  "name": "panorama",
  "version": "1.0.0",
  "description": "Panorama - Full stack application",
  "scripts": {
    "dev": "concurrently -k -n backend,frontend \"npm run dev:backend\" \"npm run dev:frontend\"",
    "start": "npm run dev",
    "dev:backend": "python backend/manage.py runserver 127.0.0.1:8001",
    "dev:frontend": "npm --prefix frontend run dev"
  },
  "devDependencies": {
    "concurrently": "^8.2.2"
  }
}
