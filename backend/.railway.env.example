# Railway Environment Variables Example
# Copy these to Railway dashboard → Service → Variables

# Django Settings
SECRET_KEY=your-secret-key-here-generate-with-django
DEBUG=False
ALLOWED_HOSTS=*

# Database (automatically set by Railway if you add PostgreSQL service)
# DATABASE_URL=postgresql://user:password@host:port/dbname

# S3/MinIO (REQUIRED for media storage)
AWS_ACCESS_KEY_ID=your-access-key
AWS_SECRET_ACCESS_KEY=your-secret-key
AWS_STORAGE_BUCKET_NAME=your-bucket-name
# For MinIO: AWS_S3_ENDPOINT_URL=http://localhost:9000

# Gemini AI (Optional)
GEMINI_API_KEY=your-gemini-api-key

# Database Connection Settings (Optional)
DB_CONN_MAX_AGE=0

# Railway automatically sets:
# - PORT (for gunicorn binding)
# - RAILWAY_ENVIRONMENT
# - RAILWAY_PUBLIC_DOMAIN (if you enable public domain)
