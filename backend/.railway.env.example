# Railway Environment Variables Example
# Copy these to Railway dashboard → Service → Variables

# Django Settings
SECRET_KEY=your-secret-key-here-generate-with-django
DEBUG=False
ALLOWED_HOSTS=*

# Frontend (used in emails, CORS, CSRF)
# Single domain (backward-compatible):
FRONTEND_PUBLIC_URL=https://your-frontend-domain.com
# Multiple domains (comma-separated):
# FRONTEND_PUBLIC_URLS=https://your-frontend-domain.com,https://your-second-frontend-domain.com

# Database (automatically set by Railway if you add PostgreSQL service)
# DATABASE_URL=postgresql://user:password@host:port/dbname

# S3/MinIO (REQUIRED for media storage)
AWS_ACCESS_KEY_ID=your-access-key
AWS_SECRET_ACCESS_KEY=your-secret-key
AWS_STORAGE_BUCKET_NAME=your-bucket-name
# For MinIO: AWS_S3_ENDPOINT_URL=http://localhost:9000
# Optional but recommended when multiple deployments share one bucket.
# Use a unique value per deployment/client to prevent app settings image collisions.
MEDIA_KEY_PREFIX=client-a

# Gemini AI (Optional)
GEMINI_API_KEY=your-gemini-api-key

# Database Connection Settings (Optional)
DB_CONN_MAX_AGE=0

# Cron token for protected /api/cron/* endpoints
CRON_SECRET_TOKEN=change-me-long-random-token

# Database backup to S3 (hourly cron can call /api/cron/database-backup/)
# IMPORTANT: dedicated backup config only (no fallback to app media S3 variables).
DB_BACKUP_S3_BUCKET=your-dedicated-backup-bucket
DB_BACKUP_S3_ACCESS_KEY_ID=your-backup-access-key
DB_BACKUP_S3_SECRET_ACCESS_KEY=your-backup-secret-key
# Optional custom key prefix (default: database-backups)
# DB_BACKUP_S3_PREFIX=database-backups/production
# Optional endpoint for S3-compatible storage (MinIO, etc.)
# DB_BACKUP_S3_ENDPOINT=https://s3.your-provider.com
# Optional region (default: us-east-1)
# DB_BACKUP_S3_REGION=eu-west-3
# Optional path-style mode (true/false), useful for MinIO and some S3-compatible providers
# DB_BACKUP_S3_FORCE_PATH_STYLE=true
# Optional path to pg_dump binary (default: pg_dump)
# DB_BACKUP_PG_DUMP_BIN=/usr/bin/pg_dump

# Railway automatically sets:
# - PORT (for gunicorn binding)
# - RAILWAY_ENVIRONMENT
# - RAILWAY_PUBLIC_DOMAIN (if you enable public domain)
